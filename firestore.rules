rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserWardrobeProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'initialized', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'initialized', 'createdAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.initialized is bool
        && data.createdAt is timestamp;
    }

    function isValidWardrobeItem(data, userId) {
      return data.keys().hasAll(['ownerId', 'category', 'name', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'category', 'name', 'createdAt'])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.category is string
        && data.category in ['shirt', 'upper', 'trouser']
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.name.matches('^[a-zA-Z0-9 \'\\-\\/&().]+$')
        && data.createdAt is timestamp;
    }

    // --- User Wardrobe Root Profile ---
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserWardrobeProfile(incoming(), userId)
        && incoming().createdAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserWardrobeProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['initialized'])
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt;

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      // --- User Wardrobe Items Subcollection ---
      match /items/{itemId} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow list: if isVerifiedUser()
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidWardrobeItem(incoming(), userId)
          && incoming().createdAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId))
            || existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidWardrobeItem(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'name'])
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt;

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
